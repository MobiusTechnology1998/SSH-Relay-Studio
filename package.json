{
  "name": "ssh-relay-desktop",
  "productName": "SSH Relay Studio",
  "version": "1.2.2",
  "description": "A/B 设备双角色 Windows OpenSSH 加密隧道中转桌面管理工具",
  "author": "SSH Relay Studio",
  "private": true,
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "package:win-zip": "npm run build && electron-builder --win zip --x64",
    "package:win-nsis": "npm run build && electron-builder --win nsis --x64",
    "package:win-portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
